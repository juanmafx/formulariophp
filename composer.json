{
    "name": "juanmafx/formulariophp",
    "description": "Hardened PHP contact form with an encrypted submission store and a TOTP-protected admin area.",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.4",
        "ext-fileinfo": "*",
        "ext-mbstring": "*",
        "ext-pdo": "*",
        "ext-pdo_sqlite": "*",
        "ext-sodium": "*",
        "paragonie/constant_time_encoding": "^3.1",
        "spomky-labs/otphp": "^11.5",
        "symfony/dotenv": "^8.0",
        "symfony/mailer": "^8.0"
    },
    "autoload": {
        "psr-4": {
            "ContactForm\\": "backend/src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ContactForm\\Tests\\": "backend/tests/"
        }
    },
    "config": {
        "allow-plugins": false,
        "platform": {
            "php": "8.4.0"
        },
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --no-progress --memory-limit=512M"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.3",
        "phpunit/phpunit": "^12.5"
    }
}
